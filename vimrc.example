set nocompatible
filetype plugin indent on
syntax on

set encoding=utf-8
set hidden           " switch buffers without saving
set updatetime=300   " faster updates
set signcolumn=yes   " keep gutter stable
set expandtab shiftwidth=2 softtabstop=2 tabstop=2
set smartindent
set ignorecase smartcase incsearch hlsearch
set completeopt=menuone,noinsert,noselect
set mouse=a
set termguicolors


" Plugins
call plug#begin('~/.vim/plugged')

Plug 'itchyny/lightline.vim'   " statusline

Plug 'dense-analysis/ale'

Plug 'fatih/vim-go'

call plug#end()


packadd lsp

call LspOptionsSet(#{
      \ autoHighlightDiags: v:true,
      \ autoComplete: v:true,
      \ showDiagWithVirtualText: v:true,
      \ showDiagInPopup: v:true,
      \ })

call LspAddServer([
      \ #{
      \   name: 'typescript-language-server',
      \   filetype: ['javascript'],
      \   path: 'typescript-language-server',
      \   args: ['--stdio'],
      \ }
      \ ])

augroup LspJsSetup
  autocmd!
  autocmd User LspAttached call s:on_lsp_attached()
augroup END

function! s:on_lsp_attached() abort
  setlocal signcolumn=yes
  nnoremap <buffer> gd :LspGotoDefinition<CR>
  nnoremap <buffer> gr :LspShowReferences<CR>
  nnoremap <buffer> gi :LspGotoImpl<CR>
  nnoremap <buffer> K  :LspHover<CR>
  nnoremap <buffer> <leader>rn  :LspRename<CR>
  nnoremap <buffer> [g :LspDiagPrev<CR>
  nnoremap <buffer> ]g :LspDiagNext<CR>
  nnoremap <buffer> <leader>ca :LspCodeAction<CR>
endfunction

let g:ale_linters = {
      \ 'javascript': ['eslint'],
      \ 'go': ['golangci-lint', 'govet', 'staticcheck'],
      \ }
let g:ale_fixers = {
\   'javascript': ['biome', 'eslint'],
\   'go': ['gofmt', 'goimports'],
\}
let g:ale_fix_on_save = 1
let g:ale_disable_lsp = 1
let g:ale_linters_explicit = 1
let g:ale_javascript_biome_executable = 'biome'
let g:ale_javascript_biome_use_global = 0

" Use local eslint
let g:ale_javascript_eslint_use_global = 0
let g:ale_javascript_eslint_executable = 'eslint'

let g:ale_sign_error = 'x'
let g:ale_sign_warning = '⚠'
let g:ale_virtualtext_cursor = 'current'


let g:go_fmt_command = 'gofumpt'         " stricter
let g:go_fmt_autosave = 1
let g:go_imports_autosave = 1
let g:go_metalinter_autosave = 0         " avoid double-running
let g:go_gopls_enabled = 1               " vim gopls integration
let g:go_def_mode = 'gopls'
let g:go_info_mode = 'gopls'
let g:go_highlight_types = 1
let g:go_highlight_fields = 1
let g:go_highlight_functions = 1
let g:go_highlight_function_calls = 1
let g:go_highlight_operators = 1
let g:go_highlight_build_constraints = 1
let g:go_highlight_generate_tags = 1

augroup GoMappings
  autocmd!
  autocmd FileType go nmap <buffer> gd <Plug>(go-def)
  autocmd FileType go nmap <buffer> K  <Plug>(go-doc)
  autocmd FileType go nmap <buffer> gr <Plug>(go-referrers)
  autocmd FileType go nmap <buffer> <leader>t :GoTest<CR>
  autocmd FileType go nmap <buffer> <leader>r :GoRun<CR>
  autocmd FileType go nmap <buffer> <leader>b :GoBuild<CR>
augroup END

augroup FiletypeSettings
  autocmd!
  autocmd FileType go setlocal noexpandtab tabstop=4 shiftwidth=4
  autocmd FileType javascript setlocal expandtab tabstop=2 shiftwidth=2
  autocmd BufNewFile,BufRead tsconfig.json,jsconfig.json setlocal filetype=jsonc
  autocmd BufNewFile,BufRead *.mjs set filetype=javascript
augroup END
